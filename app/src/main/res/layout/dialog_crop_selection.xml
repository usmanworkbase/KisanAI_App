<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_your_crop"
        android:textColor="@color/black"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAlignment="center"/>

    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/select_crop_desc"
        android:textColor="#666666"
        android:textSize="14sp"
        android:textAlignment="center"/>

    <RadioGroup
        android:id="@+id/rgCrops"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">

        <RadioButton
            android:id="@+id/rbWheat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/crop_wheat"
            android:textSize="16sp"
            android:buttonTint="@color/primary_green"/>

        <RadioButton
            android:id="@+id/rbSugarcane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/crop_sugarcane"
            android:textSize="16sp"
            android:buttonTint="@color/primary_green"/>

        <RadioButton
            android:id="@+id/rbPotato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/crop_potato"
            android:textSize="16sp"
            android:buttonTint="@color/primary_green"/>

        <RadioButton
            android:id="@+id/rbMaize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/crop_maize"
            android:textSize="16sp"
            android:buttonTint="@color/primary_green"/>

        <RadioButton
            android:id="@+id/rbRice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/crop_rice"
            android:textSize="16sp"
            android:buttonTint="@color/primary_green"/>

    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="@string/confirm_selection"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:backgroundTint="@color/primary_green"/>

</LinearLayout>
